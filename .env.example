# Variables read by Patchwork. Copy to .env (ignored by Git) or set them in your shell
# or in the "env" block of your MCP client. Patchwork itself never loads a .env file.
# Never commit real values.

# Password of the FileMaker account given to `patchwork open` (required unless --no-password).
# Use a dedicated account rather than your main one: see SECURITY.md.
PATCHWORK_PASSWORD=

# Encryption key, only for files protected with encryption at rest (EAR).
PATCHWORK_KEY=

# Folder holding the .patchwork workspace. Default: the source file's folder.
PATCHWORK_PROJECT=

# Set to 1 to let MCP tools save or open outside the project folder.
PATCHWORK_ALLOW_OUTSIDE=

# Paths to the Claris tools, when they are not found automatically.
FM_UPGRADE_TOOL=
FM_DEVELOPER_TOOL=

# Tests only: a real .fmp12 for the end-to-end tests (tests/test_integration.py).
PATCHWORK_SAMPLE=
